# ─── Database ────────────────────────────────────────
DATABASE_URL="postgresql://branddeals:branddeals@localhost:5432/branddeals?schema=public"

# ─── Redis ───────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Auth ────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-change-in-production"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─── API ─────────────────────────────────────────────
API_URL="http://localhost:3001"
API_PORT=3001
JWT_SECRET="your-jwt-secret-change-in-production"
JWT_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ─── Email (Resend) ─────────────────────────────────
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="noreply@branddeals.schbang.com"

# ─── File Storage (S3/R2) ───────────────────────────
S3_BUCKET="branddeals-assets"
S3_REGION="ap-south-1"
S3_ACCESS_KEY="your-access-key"
S3_SECRET_KEY="your-secret-key"
S3_ENDPOINT="https://s3.ap-south-1.amazonaws.com"

# ─── App ─────────────────────────────────────────────
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="https://align.schbang.com"

# ─── Analytics & Tracking (Meta Ads, Google Ads, GTM) ──
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"
NEXT_PUBLIC_META_PIXEL_ID="123456789012345"
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
