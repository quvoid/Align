# ==============================================================================
# ALIGN (BY SCHBANG) - ENVIRONMENT CONFIGURATION
# Production: https://align-web-five.vercel.app
#
# Copy to .env.local and fill in. NEVER commit real values to this file —
# it is tracked in git, so anything here is public to everyone with repo access.
# ==============================================================================

# NextAuth / Authentication
# Required. Generate with:  openssl rand -hex 32
# The app refuses to boot in production without it.
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Comma-separated list of emails granted the ADMIN role.
# Role is assigned from this list (and later from the database), never from
# the email domain.
ADMIN_EMAILS=""

# Set to "true" only in local/staging to expose the one-click demo passkeys
# on the sign-in screen. Must be unset in production.
NEXT_PUBLIC_DEMO_MODE=""

# Google OAuth 2.0
# Both must be set for the Google provider to register; the sign-in UI derives
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED from them at build time.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Database (Supabase Postgres)
# DATABASE_URL -> transaction pooler (port 6543), used by the app at runtime.
#   Must include ?pgbouncer=true&connection_limit=1
# DIRECT_URL   -> session pooler (port 5432), used only by prisma migrate.
DATABASE_URL=""
DIRECT_URL=""

# Stripe
# Only STRIPE_PUBLISHABLE_KEY may reach the browser.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Analytics (optional — all three are inert if unset)
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
