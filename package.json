{
  "name": "branddeals",
  "version": "1.0.0",
  "private": true,
  "description": "Schbang Brand Collaboration Marketplace",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "db:generate": "pnpm --filter @branddeals/database generate",
    "db:push": "pnpm --filter @branddeals/database push",
    "db:seed": "pnpm --filter @branddeals/database seed",
    "db:studio": "pnpm --filter @branddeals/database studio",
    "clean": "turbo clean && rimraf node_modules"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.33.3",
  "devDependencies": {
    "turbo": "^2.10.11"
  }
}
